{
  "name": "cablester-prototype",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verify-public-repository-boundary.mjs --dist",
    "dev": "node scripts/serve.mjs",
    "dev:formal": "node scripts/serve.mjs --formal-world-root ../Game_Cablester/worlds/formal",
    "test": "node --test",
    "check": "node scripts/check.mjs && node scripts/verify-public-repository-boundary.mjs --source",
    "boundary:check": "node scripts/verify-public-repository-boundary.mjs --source --dist",
    "assets:audit": "python3 scripts/audit-game-assets.py",
    "performance:audit": "node scripts/audit-browser-performance.mjs",
    "world-studio:audit": "node scripts/audit-world-studio-performance.mjs",
    "experience-parity:audit": "node scripts/audit-experience-parity.mjs --check",
    "world:fixtures": "node scripts/update-world-golden-fixtures.mjs"
  }
}
